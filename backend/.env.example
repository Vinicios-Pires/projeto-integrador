# Copie este arquivo para .env e preencha.

# Porta HTTP do servidor
PORT=3333

# Banco de dados (Postgres). No Neon:
#  - DATABASE_URL = string "pooled" (host com -pooler), usada pela aplicação
#  - DIRECT_URL   = string direta (sem -pooler), usada pelo Prisma Migrate
# Em Postgres local, as duas podem ser iguais.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require&connect_timeout=15"

# Primeiro administrador, criado pelo `npm run seed` (só se ainda não existir).
# Se ADMIN_BOOTSTRAP_PASSWORD ficar vazio, uma senha temporária é gerada e
# exibida uma única vez no terminal. Em ambos os casos, a troca é exigida no 1º acesso.
ADMIN_BOOTSTRAP_EMAIL="admin@prof.educacao.sp.gov.br"
ADMIN_BOOTSTRAP_PASSWORD=""

# Login (JWT). Gere um segredo longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o segredo desconecta todo mundo (os tokens antigos deixam de valer).
JWT_SECRET=""
# Por quanto tempo o login vale antes de pedir para entrar de novo (ex.: 8h, 1d).
JWT_EXPIRES_IN="8h"

# Cadastro: só e-mails deste domínio podem criar conta.
ALLOWED_EMAIL_DOMAIN="prof.educacao.sp.gov.br"

# Limite de tentativas (por IP). Login conta só as tentativas erradas, a cada 15 min.
LOGIN_MAX_TENTATIVAS=10
CADASTRO_MAX_POR_HORA=5

# Quantos proxies há na frente da API. 0 em dev; 1 no Render.
TRUST_PROXY=0

# Endereços do frontend que podem chamar a API pelo navegador, separados por vírgula
# (em dev, o Vite roda na 8080; no ar, o endereço do site, ex.: https://painel.onrender.com).
CORS_ORIGINS="http://localhost:8080"

# Arquivos (fotos e documentos). "local" guarda numa pasta do disco (dev e testes);
# "supabase" usa o Supabase Storage (produção), com as variáveis SUPABASE_* abaixo.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
# Só com STORAGE_DRIVER="supabase". A chave service_role é SECRETA: só no servidor, nunca no git
# nem no navegador (Supabase > Project Settings > API).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
