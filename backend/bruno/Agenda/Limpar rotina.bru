meta {
  name: Limpar rotina
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/agenda/rotina/{{rotinaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("célula limpa", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  "Limpar" uma célula da rotina. Só o dono (ou o admin).

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `AGENDA_NAO_ENCONTRADA` (404).
}
