meta {
  name: Editar aluno
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/alunos/{{alunoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "numero_chamada": 2, "responsavel": "Maria Silva" }
}

tests {
  test("aluno alterado", function () {
    expect(res.status).to.equal(200);
    expect(res.body.numero_chamada).to.equal(2);
  });
}

docs {
  Altera **só os campos enviados** do aluno de `alunoId` (mesmos campos de *Cadastrar aluno*).
  Dá para trocar de turma (`turma_id`) e inativar (`"ativo": false`).
  **Qualquer usuário logado** pode editar.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400, inclusive corpo vazio),
  `TURMA_INVALIDA` (400), `ALUNO_DUPLICADO` (409), `ALUNO_NAO_ENCONTRADO` (404).
}
