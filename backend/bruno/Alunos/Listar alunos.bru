meta {
  name: Listar alunos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/alunos?turma_id={{turmaId}}&ativo=true&ordem=numero_chamada
  body: none
  auth: bearer
}

params:query {
  turma_id: {{turmaId}}
  ativo: true
  ordem: numero_chamada
}

auth:bearer {
  token: {{token}}
}

tests {
  test("lista devolvida", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  Lista os alunos, cada um com `turmas: { nome, serie }`. **Qualquer usuário logado** vê todos.

  Filtros opcionais (aba *Params*; apague um para não filtrar):
  - `turma_id`: uma turma ou várias separadas por vírgula;
  - `ativo`: `true` ou `false`;
  - `ordem`: `turma` (padrão: turma e número da chamada), `numero_chamada` ou `nome`.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400, filtro inválido).
}
