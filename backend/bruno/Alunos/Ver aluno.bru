meta {
  name: Ver aluno
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/alunos/{{alunoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("aluno devolvido", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getEnvVar("alunoId"));
  });
}

docs {
  Mostra o aluno de `alunoId`. Qualquer usuário logado pode ver.

  Erros possíveis: `NAO_AUTENTICADO` (401), `ALUNO_NAO_ENCONTRADO` (404).
}
