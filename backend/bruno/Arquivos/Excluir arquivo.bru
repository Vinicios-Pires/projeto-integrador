meta {
  name: Excluir arquivo
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/files/pdi-documentos?path={{arquivoPath}}
  body: none
  auth: bearer
}

params:query {
  path: {{arquivoPath}}
}

auth:bearer {
  token: {{token}}
}

tests {
  test("arquivo excluído", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Exclui o arquivo de `arquivoPath`. Para vários de uma vez: `POST /files/:bucket/excluir`
  com `{ "paths": [...] }` (ou saem todos, ou nenhum).

  Quem pode: o **dono** e o **admin**. A gestão vê, mas não exclui.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400), `SEM_PERMISSAO` (403, gestão),
  `ARQUIVO_NAO_ENCONTRADO` (404).
}
