meta {
  name: Quem sou eu
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("devolve o usuário logado", function () {
    expect(res.status).to.equal(200);
    expect(res.body.user.email).to.equal(bru.getEnvVar("email"));
  });
}

docs {
  Dados do dono do token: `user`, `role`, `profile` e `deve_trocar_senha`.
  Funciona mesmo com senha temporária.
  
  Erros possíveis: `NAO_AUTENTICADO` (401, sem token / token inválido ou vencido),
  `CONTA_PENDENTE` / `CONTA_INATIVA` (403).
}
