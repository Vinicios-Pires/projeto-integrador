meta {
  name: Editar ano letivo
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/ano-letivo/{{anoLetivoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "ativo": false }
}

tests {
  test("ano alterado", function () {
    expect(res.status).to.equal(200);
    expect(res.body.ativo).to.equal(false);
  });
}

docs {
  Altera **só os campos enviados** do ano de `anoLetivoId`. **Só admin.**

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `DADOS_INVALIDOS` (400),
  `ANO_LETIVO_NAO_ENCONTRADO` (404), `ANO_LETIVO_DUPLICADO` (409).
}
