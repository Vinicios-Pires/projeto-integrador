meta {
  name: Excluir ano letivo
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/ano-letivo/{{anoLetivoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("ano excluído", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Exclui o ano de `anoLetivoId`. **Só admin.**

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `ANO_LETIVO_NAO_ENCONTRADO` (404).
}
