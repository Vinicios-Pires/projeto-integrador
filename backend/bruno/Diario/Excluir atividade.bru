meta {
  name: Excluir atividade
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/diario/atividades/{{atividadeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("atividade excluída", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Exclui a atividade; os lançamentos dela saem junto. Só o dono (ou o admin).

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `ATIVIDADE_NAO_ENCONTRADA` (404).
}
