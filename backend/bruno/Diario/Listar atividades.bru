meta {
  name: Listar atividades
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/diario/atividades?turma_id={{turmaId}}&bimestre=1
  body: none
  auth: bearer
}

params:query {
  turma_id: {{turmaId}}
  bimestre: 1
}

auth:bearer {
  token: {{token}}
}

tests {
  test("atividades da turma", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  As colunas do diário, na ordem. Filtros: `turma_id`, `disciplina_id`, `bimestre`. O professor vê o seu; a
  gestão, todos. `peso` sai como número; `data` como `AAAA-MM-DD`.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400).
}
