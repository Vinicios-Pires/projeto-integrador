meta {
  name: Concluir lembrete
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/lembretes/{{lembreteId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "concluido": true
  }
}

tests {
  test("lembrete concluído", function () {
    expect(res.status).to.equal(200);
    expect(res.body.concluido).to.equal(true);
  });
}

docs {
  Marca o lembrete como feito. Altera só o que for enviado.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400), `LEMBRETE_NAO_ENCONTRADO` (404).
}
