meta {
  name: Excluir apoio presencial
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/apoio-presencial/{{apoioId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("apoio excluído", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  **Gestão** exclui o apoio presencial.

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `APOIO_NAO_ENCONTRADO` (404).
}
