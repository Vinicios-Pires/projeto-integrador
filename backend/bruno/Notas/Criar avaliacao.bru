meta {
  name: Criar avaliacao
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tipos-avaliacao
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nome": "Prova 1",
    "turma_id": "{{turmaId}}",
    "disciplina_id": "{{disciplinaId}}",
    "bimestre": 1,
    "peso": 2
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("tipoAvaliacaoId", res.body.id);
  }
}

tests {
  test("avaliação criada", function () {
    expect(res.status).to.equal(201);
    expect(res.body.peso).to.equal(2);
  });
}

docs {
  Cria uma avaliação (uma coluna da planilha de notas) na turma de `turmaId` e matéria de
  `disciplinaId` (rode antes *Turmas > Criar turma* e *Materias > Criar materia*). Fica salva em
  `tipoAvaliacaoId`.

  Obrigatórios: `nome`, `turma_id`, `disciplina_id`, `bimestre` (1 a 4). Opcionais: `peso` (maior que
  zero; padrão 1), `categoria` (`normal` ou `prova_paulista`), `ordem` (sem ela, vai para o fim) e `descricao`.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400), `TURMA_INVALIDA` (400),
  `DISCIPLINA_INVALIDA` (400).
}
