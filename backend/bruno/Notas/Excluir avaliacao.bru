meta {
  name: Excluir avaliacao
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/tipos-avaliacao/{{tipoAvaliacaoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("avaliação excluída", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Exclui a avaliação de `tipoAvaliacaoId`. **As notas dela saem junto** (a tela já avisa).

  Quem pode: o **dono** e o **admin**.

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `AVALIACAO_NAO_ENCONTRADA` (404).
}
