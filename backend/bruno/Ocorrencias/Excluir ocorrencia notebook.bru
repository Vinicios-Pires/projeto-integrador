meta {
  name: Excluir ocorrencia notebook
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/ocorrencias-notebook/{{ocorrenciaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("ocorrência excluída", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Exclui a ocorrência; as fotos saem junto, do banco e do armazenamento. Só o dono (ou o admin).

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `OCORRENCIA_NAO_ENCONTRADA` (404).
}
