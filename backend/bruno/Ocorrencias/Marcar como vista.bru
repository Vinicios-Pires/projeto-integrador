meta {
  name: Marcar como vista
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/ocorrencias-escolares/{{ocorrenciaEscolarId}}/visto
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("marcada como vista", function () {
    expect(res.status).to.equal(200);
    expect(res.body.visto_pelo_professor).to.equal(true);
  });
}

docs {
  O professor que registrou marca a resposta da gestão como vista.

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `OCORRENCIA_NAO_ENCONTRADA` (404).
}
