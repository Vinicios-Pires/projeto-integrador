meta {
  name: Remover ocorrencia escolar
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/ocorrencias-escolares/{{ocorrenciaEscolarId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("ocorrência removida", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Remove a ocorrência. Só quem registrou (ou o admin).

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `OCORRENCIA_NAO_ENCONTRADA` (404).
}
