meta {
  name: Responder ocorrencia
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/ocorrencias-escolares/{{ocorrenciaEscolarId}}/resposta
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "em_andamento",
    "providencias": "Conversa com a família agendada."
  }
}

tests {
  test("ocorrência respondida", function () {
    expect(res.status).to.equal(200);
    expect(res.body.visto_pelo_professor).to.equal(false);
  });
}

docs {
  **Gestão** responde: `status` (nova, em_andamento, resolvida) e `providencias`. Grava quem respondeu e
  quando, e marca como "não vista" para avisar o professor. O professor marca como vista em
  `POST /ocorrencias-escolares/:id/visto`.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400), `SEM_PERMISSAO` (403),
  `OCORRENCIA_NAO_ENCONTRADA` (404).
}
