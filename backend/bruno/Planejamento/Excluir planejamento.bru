meta {
  name: Excluir planejamento
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/planejamentos/{{planejamentoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("planejamento excluído", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Exclui o planejamento (as aulas continuam existindo, fora dele). Só o dono (ou o admin), e **não se estiver
  validado**: a gestão precisa reabrir antes.

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `PLANEJAMENTO_NAO_ENCONTRADO` (404),
  `PLANEJAMENTO_VALIDADO` (409).
}
