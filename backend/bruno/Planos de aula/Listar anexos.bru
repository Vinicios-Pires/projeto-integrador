meta {
  name: Listar anexos
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/planos-aula/{{planoId}}/anexos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("anexos da aula", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  Os anexos da aula (`?tipo=documento|adaptada` filtra). Dono e gestão veem.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400), `PLANO_NAO_ENCONTRADO` (404).
}
