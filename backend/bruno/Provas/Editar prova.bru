meta {
  name: Editar prova
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/provas/{{provaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "titulo": "Avaliação de Ciências (revisada)",
    "valor_total": 8
  }
}

tests {
  test("prova alterada", function () {
    expect(res.status).to.equal(200);
    expect(res.body.valor_total).to.equal(8);
  });
}

docs {
  Altera só os campos enviados. Com menos questões, o gabarito das que sobram sai junto. Se a prova já tem
  respostas de alunos, a turma não muda.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400), `TURMA_INVALIDA` (400),
  `DISCIPLINA_INVALIDA` (400), `SEM_PERMISSAO` (403), `PROVA_NAO_ENCONTRADA` (404), `PROVA_COM_RESULTADOS` (409).
}
