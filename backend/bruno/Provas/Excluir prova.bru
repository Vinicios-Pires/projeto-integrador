meta {
  name: Excluir prova
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/provas/{{provaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("prova excluída", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Exclui a prova; o gabarito e as respostas dos alunos saem junto. Só o dono (ou o admin).

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `PROVA_NAO_ENCONTRADA` (404).
}
