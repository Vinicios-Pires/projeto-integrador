meta {
  name: Listar provas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/provas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("lista as provas", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  Lista as provas, as mais novas primeiro, com `turmas: { nome, serie }` e `disciplinas: { nome }`. Filtros:
  `turma_id`, `disciplina_id`, `bimestre`. O professor vê as próprias; a gestão vê todas.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400).
}
