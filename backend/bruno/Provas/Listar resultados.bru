meta {
  name: Listar resultados
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/provas/{{provaId}}/resultados
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("folhas corrigidas", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  As folhas corrigidas da prova, em ordem de chamada, com `alunos: { nome, numero_chamada }`. Dono e gestão
  veem.

  Erros possíveis: `NAO_AUTENTICADO` (401), `PROVA_NAO_ENCONTRADA` (404).
}
