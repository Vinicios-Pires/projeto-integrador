meta {
  name: Excluir tutorado
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/tutorados/{{tutoradoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("tutorado excluído", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Exclui o tutorado com todo o acompanhamento, a foto e os documentos (banco e armazenamento). O cadastro do
  aluno não muda. Só o tutor (ou o admin).

  Erros possíveis: `NAO_AUTENTICADO` (401), `SEM_PERMISSAO` (403), `TUTORADO_NAO_ENCONTRADO` (404).
}
