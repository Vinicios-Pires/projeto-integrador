meta {
  name: Vincular alunos
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tutorados/vincular
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "aluno_ids": ["{{alunoId}}"]
  }
}

script:post-response {
  if (res.status === 201 && res.body.criados[0]) bru.setEnvVar("tutoradoId", res.body.criados[0].id);
}

tests {
  test("alunos vinculados", function () {
    expect(res.status).to.equal(201);
    expect(res.body.criados).to.be.an("array");
  });
}

docs {
  Vincula alunos como tutorados de quem está logado (nome, turma e número de chamada vêm do cadastro do aluno).
  Os que já são seus tutorados ficam de fora: resposta `{ criados: [...], ja_existiam: n }`. Para um tutorado
  sem cadastro: `POST /tutorados` com `{ nome, turma?, numero_chamada?, status? }`. Lista: `GET /tutorados?status=&user_id=`.
  Guarda o id em `tutoradoId`.

  Erros possíveis: `NAO_AUTENTICADO` (401), `DADOS_INVALIDOS` (400), `ALUNO_INVALIDO` (400),
  `TUTORADO_DUPLICADO` (409).
}
