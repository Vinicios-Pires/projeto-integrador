meta {
  name: Inativar
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/users/{{usuarioId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "status": "inativo" }
}
tests {
  test("usuário inativo", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("inativo");
  });
}

docs {
  Inativa a conta: a pessoa perde o acesso **na hora**, mesmo se já estiver logada. **Só admin.**

  Erros possíveis: `SEM_PERMISSAO` (403), `USUARIO_NAO_ENCONTRADO` (404), `ACAO_EM_SI_MESMO` (400).
}
