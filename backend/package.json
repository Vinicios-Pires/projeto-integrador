    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "db:check": "tsx scripts/verificar-banco.ts",
    "test:login": "tsx scripts/testar-login.ts",
    "test:cadastro": "tsx scripts/testar-cadastro.ts",
    "test:usuarios": "tsx scripts/testar-usuarios.ts",
    "test:turmas": "tsx scripts/testar-turmas.ts",
    "test:alunos": "tsx scripts/testar-alunos.ts",
    "test:disciplinas": "tsx scripts/testar-disciplinas.ts",
    "test:membros": "tsx scripts/testar-membros.ts",
    "test:calendario": "tsx scripts/testar-calendario.ts",
    "test:arquivos": "tsx scripts/testar-arquivos.ts",
    "test:supabase-storage": "tsx scripts/testar-supabase-storage.ts",
    "test:notas": "tsx scripts/testar-notas.ts",
    "test:medias": "tsx scripts/testar-medias.ts",
    "test:provas": "tsx scripts/testar-provas.ts",
    "test:correcao": "tsx scripts/testar-correcao.ts",
    "test:planejamentos": "tsx scripts/testar-planejamentos.ts",
    "test:planos": "tsx scripts/testar-planos.ts",
    "test:aprovacao": "tsx scripts/testar-aprovacao.ts",
    "test:diario": "tsx scripts/testar-diario.ts",
    "test:agenda": "tsx scripts/testar-agenda.ts",
    "test:escola": "tsx scripts/testar-escola.ts",
    "test:ocorrencias": "tsx scripts/testar-ocorrencias.ts",
    "test:pdi": "tsx scripts/testar-pdi.ts",
    "test:tutoria": "tsx scripts/testar-tutoria.ts",
